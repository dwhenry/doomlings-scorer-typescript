{
  "name": "doomlings-scorer",
  "private": true,
  "workspaces": ["lib", "web"],
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "build": "npm run build --workspace=lib && npm run build --workspace=web",
    "start": "node lib/dist/server.js",
    "test": "npm test --workspace=lib",
    "dev": "npm run dev --workspace=web",
    "format": "prettier --config .prettierrc '{lib,web}/**/*.ts' '{lib,web}/**/*.tsx' --write"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "eslint": "^9.6.0",
    "eslint-config-semistandard": "^17.0.0",
    "eslint-config-standard": "^17.0.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^17.9.0",
    "eslint-plugin-promise": "^6.4.0",
    "prettier": "^3.3.2"
  }
}
